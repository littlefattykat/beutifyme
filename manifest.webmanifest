{
  "name": "BeautifyMe",
  "short_name": "BeautifyMe",
  "description": "Apple Health style calorie, activity and weight tracker.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-rounded-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
